#!/bin/sh
# Pre-commit hook: reject staged content carrying mojibake or invalid UTF-8.
# Uses PowerShell 7 when available, otherwise Windows PowerShell 5.1.

set -eu

root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
else
  PS=powershell
fi

if ! "$PS" -NoProfile -File "$root/Tools/Check-Mojibake.ps1" -Files -Staged; then
  echo "pre-commit: mojibake check failed (staged files). Run the script with -Files to inspect all tracked files." >&2
  exit 1
fi

# Secret scan: inspect staged content with gitleaks when it is installed.
# Missing gitleaks only warns; CI (secret-scan.yml) always scans.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact; then
    echo "pre-commit: gitleaks reported possible secrets in staged changes." >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks not installed, secret scan skipped (CI still scans)." >&2
fi

exit 0