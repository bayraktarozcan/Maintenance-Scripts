#!/bin/sh
# Pre-push hook: reject pushed commits whose messages or authors carry mojibake
# or invalid UTF-8. Ranges are per ref as reported by git on stdin.

set -eu

root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
else
  PS=powershell
fi

z40=0000000000000000000000000000000000000000
failed=0

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    continue
  fi
  if [ "$remote_sha" = "$z40" ]; then
    range=--all
  else
    range="$remote_sha..$local_sha"
  fi
  if ! "$PS" -NoProfile -File "$root/Scripts/Check-Mojibake.ps1" -Commits -CommitRange "$range"; then
    echo "pre-push: mojibake check failed for $local_ref ($local_sha)." >&2
    failed=1
  fi
done

exit "$failed"