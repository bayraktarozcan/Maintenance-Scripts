#!/bin/sh
# Commit-msg hook: reject a commit message carrying mojibake or invalid UTF-8.

set -eu

root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
else
  PS=powershell
fi

if ! "$PS" -NoProfile -File "$root/Scripts/Check-Mojibake.ps1" -Message "$1"; then
  echo "commit-msg: commit message failed the mojibake check." >&2
  exit 1
fi

exit 0